# =============================================================================
# Sokoni environment template
# Copy to .env and adjust values. Never commit the real .env file.
# =============================================================================

# Django
DJANGO_ENV=local
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=dev-only-change-me-before-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Nairobi

# Database — use postgresql (default) with Docker Compose, or sqlite for quick local smoke tests
DATABASE_ENGINE=postgresql
POSTGRES_DB=sokoni
POSTGRES_USER=sokoni
POSTGRES_PASSWORD=sokoni
POSTGRES_HOST=localhost
# Port Django connects to. Use 5432 for a locally installed PostgreSQL.
# If you also run the Compose database, set this to POSTGRES_HOST_PORT instead.
POSTGRES_PORT=5432
# Host port published by the Compose postgres container (kept off 5432 to avoid clashes)
POSTGRES_HOST_PORT=5433

# Redis (reserved for Celery in later phases)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6380

# JWT (leave JWT_SIGNING_KEY empty to reuse DJANGO_SECRET_KEY)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
JWT_SIGNING_KEY=

# CORS — Next.js frontend (future)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Docker Compose web port
WEB_PORT=8000

# Agent confirmation (B8). A voice pipeline will report confidence later;
# these thresholds decide when a write waits for a yes.
AGENT_CONFIDENCE_THRESHOLD=0.75
AGENT_UNUSUAL_AMOUNT_FACTOR=5
AGENT_CONFIRMATION_TTL_SECONDS=300

# Rate limits. Auth is tight because a guessed password is a stolen business.
THROTTLE_ANON=60/min
THROTTLE_USER=120/min
THROTTLE_AUTH=10/min
THROTTLE_AGENT=30/min

# Future (do not set until those phases)
# ELEVENLABS_API_KEY=
# LLM_API_KEY=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
